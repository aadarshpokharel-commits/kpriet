{
  "name": "piyushdhara-mathboard",
  "version": "1.0.0",
  "description": "PiyushDhara EduVerse — Interactive Math Teaching Software for Nepal SEE",
  "main": "main.js",
  "author": "PiyushDhara EduVerse",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "serve": "node serve.js",
    "dashboard": "electron . --dashboard",
    "login": "electron . --login",
    "portal": "electron . --dashboard",
    "smartboard": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.piyushdhara.eduverseboard",
    "productName": "PiyushDhara EduVerse Board",
    "copyright": "Copyright © 2026 PiyushDhara EduVerse",
    "icon": "assets/logo.png",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "PiyushDhara-EduVerse-Board-Portable.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!dist/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3"
  }
}
