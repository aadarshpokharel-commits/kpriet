# ─────────────────────────────────────────────────────────────
# Eduverse Dashboard API — copy to .env and fill in real values.
# Never commit .env. Every value here is validated at startup
# (src/config/env.ts); the server refuses to boot on bad config.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB — local instance or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/eduverse
# Optional: overrides the database name in the URI
MONGODB_DB_NAME=
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=3000

# Comma-separated list of browser origins allowed to call the API.
# "*" is rejected because the API sends credentials (cookies).
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 = none).
# Set to 1 behind Nginx / a single load balancer so client IPs are correct.
TRUST_PROXY=0

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
JSON_BODY_LIMIT=100kb

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long!
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_min_32_chars_long!

# AI / RAG Integration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
