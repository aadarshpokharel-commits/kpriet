# ─────────────────────────────────────────────────────────────
# Eduverse Dashboard (frontend) — copy to .env.local.
# Everything prefixed VITE_ is bundled into the browser build:
# NEVER put secrets here.
# ─────────────────────────────────────────────────────────────

# API base URL. Either a path on the same origin (recommended, used with the
# dev proxy / a reverse proxy in production) or a full URL.
VITE_API_BASE_URL=/api/v1

# Dev server only: where /api requests are forwarded.
VITE_DEV_PROXY_TARGET=http://localhost:5000

VITE_API_TIMEOUT_MS=15000

# Path the dashboard is served under. "/" standalone, "/dashboard/" if it
# is mounted beneath the public website.
VITE_BASE_PATH=/

VITE_APP_NAME=Eduverse Dashboard

# Link back to the existing public website (Home page).
VITE_PUBLIC_SITE_URL=http://localhost:3000
